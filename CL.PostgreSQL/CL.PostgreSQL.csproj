<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CL.PostgreSQL</RootNamespace>
    <AssemblyName>CL.PostgreSQL</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>CodeLogic.PostgreSQL</PackageId>
    <PackageTags>postgresql;postgres;npgsql;database;orm;linq;repository;migrations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Media2A</Authors>
    <Description>Typed PostgreSQL data access for CodeLogic 4: repositories, a LINQ query builder with joins, projections and cursor paging, ON CONFLICT upserts, declarative schema sync, database-tracked migrations, and a self-invalidating result cache.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.*" />
  </ItemGroup>  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>