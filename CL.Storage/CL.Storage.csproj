<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CL.Storage</RootNamespace>
    <AssemblyName>CL.Storage</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodeLogic.Storage</PackageId>
    <PackageTags>storage;filesystem;cloud;s3;ftp;ftps;sftp;webdav;azure;gcs;swift</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Provider-neutral storage abstractions and providers for CodeLogic applications</Description>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.6" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="WebDAVClient" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="MIGRATION.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
