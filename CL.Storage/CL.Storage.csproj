<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CL.Storage</RootNamespace>
    <AssemblyName>CL.Storage</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodeLogic.Storage</PackageId>
    <PackageTags>storage;filesystem;cloud;ftp;sftp;webdav</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Provider-neutral storage abstractions and providers for CodeLogic applications</Description>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
